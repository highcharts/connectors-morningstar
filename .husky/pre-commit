npm run husky:pre-commit

# Keep docs/sitemap.xml in sync with the docs. If this commit touches the docs
# pages or the generator, regenerate the sitemap and stage it.
if git diff --cached --name-only |
    grep -qE '^(docs/connectors/|tools/sitemap\.ts)'; then
    npm run sitemap
    git add docs/sitemap.xml
fi
